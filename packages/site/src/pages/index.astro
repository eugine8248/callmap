---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="callmap — See what a pull request actually changes">
  <!-- Hero -->
  <section class="border-b border-[var(--border)]">
    <div class="max-w-5xl mx-auto px-5 py-16 md:py-20">
      <div class="flex items-center gap-2 mb-4">
        <span class="inline-block px-2 py-0.5 text-[11px] rounded bg-[rgba(0,122,204,0.18)] text-[var(--accent)] border border-[var(--accent)]">v1.0 · launching now</span>
        <span class="text-xs text-[var(--text-secondary)]">MIT · free · open source</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-semibold leading-tight tracking-tight">
        See what a pull request <span class="text-[var(--diff-added)]">actually</span> changes.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-[var(--text-secondary)]">
        callmap is a focused callgraph viewer for code reviewers. Paste a GitHub PR URL —
        get a colour-coded delta graph of every function the PR added, removed, or modified,
        plus their direct callers and callees. Nothing more, nothing missing.
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <a href="https://github.com/eugine8248/callmap/releases" rel="noopener"
          class="!text-white !no-underline px-4 py-2 rounded bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-sm font-medium">
          Download desktop
        </a>
        <a href="https://marketplace.visualstudio.com/items?itemName=callmap.callmap" rel="noopener"
          class="!text-[var(--text-primary)] !no-underline px-4 py-2 rounded border border-[var(--border-strong)] hover:bg-[var(--bg-sidebar)] text-sm">
          Install for VS Code
        </a>
        <a href={`${base}/docs/`}
          class="!text-[var(--text-primary)] !no-underline px-4 py-2 rounded border border-[var(--border-strong)] hover:bg-[var(--bg-sidebar)] text-sm">
          Read the docs
        </a>
      </div>

      <!-- Show HN / PH placeholders. Wire to live URLs at C3 launch. -->
      <div class="mt-6 flex flex-wrap items-center gap-3 text-xs text-[var(--text-secondary)]">
        <span class="px-2 py-1 border border-dashed border-[var(--border)] rounded">Show HN — coming soon</span>
        <span class="px-2 py-1 border border-dashed border-[var(--border)] rounded">Product Hunt — coming soon</span>
      </div>
    </div>
  </section>

  <!-- Demo GIF -->
  <section class="border-b border-[var(--border)]">
    <div class="max-w-5xl mx-auto px-5 py-12">
      <div class="rounded-md overflow-hidden border border-[var(--border)] bg-[#181818] shadow-2xl">
        <div class="flex items-center gap-2 px-3 py-2 bg-[var(--bg-sidebar)] border-b border-[var(--border)]">
          <span class="inline-block w-3 h-3 rounded-full bg-[#ff5f57]"></span>
          <span class="inline-block w-3 h-3 rounded-full bg-[#febc2e]"></span>
          <span class="inline-block w-3 h-3 rounded-full bg-[#28c840]"></span>
          <span class="ml-3 text-xs text-[var(--text-secondary)] font-mono">callmap — sindresorhus/p-queue#245</span>
        </div>
        <img src={`${base}/demo.svg`} alt="callmap demo: paste PR URL, see callgraph, click node for source, find a function, bookmark it" class="w-full block" />
      </div>
      <p class="text-xs text-[var(--text-secondary)] mt-3 text-center">
        Open the app, paste a PR URL, navigate the delta graph, jump to source, find a function with Ctrl+F, bookmark a node.
      </p>
    </div>
  </section>

  <!-- Feature blocks -->
  <section class="border-b border-[var(--border)]">
    <div class="max-w-5xl mx-auto px-5 py-14">
      <h2 class="text-2xl font-semibold mb-8">Built for the code-review minute</h2>
      <div class="grid md:grid-cols-2 gap-x-10 gap-y-8">
        <div>
          <h3 class="text-[var(--diff-added)] font-medium text-sm uppercase tracking-wider mb-2">PR-delta first</h3>
          <p class="text-[var(--text-secondary)]">
            Every other callgraph tool renders the whole repo. callmap only draws the slice
            of code the PR touches — added, removed, changed functions, and their one-hop
            neighbours. The colours match VS Code's diff palette so the meaning is instant.
          </p>
        </div>
        <div>
          <h3 class="text-[var(--diff-added)] font-medium text-sm uppercase tracking-wider mb-2">Multi-language</h3>
          <p class="text-[var(--text-secondary)]">
            TypeScript, JavaScript, Python, and Go via tree-sitter WASM grammars, loaded
            lazily — a JS-only PR never pays for the Python parser. Class methods and
            Go-receiver methods are name-qualified so cross-file resolution works.
          </p>
        </div>
        <div>
          <h3 class="text-[var(--diff-added)] font-medium text-sm uppercase tracking-wider mb-2">Desktop + VS Code</h3>
          <p class="text-[var(--text-secondary)]">
            Same engine, two shells. The Tauri desktop installer is under 3 MB. The VS Code
            extension reuses the host's GitHub session — no PAT to copy. PR Explorer,
            command palette, Ctrl+F find, bookmarks, minimap.
          </p>
        </div>
        <div>
          <h3 class="text-[var(--diff-added)] font-medium text-sm uppercase tracking-wider mb-2">Free, open, quiet</h3>
          <p class="text-[var(--text-secondary)]">
            MIT licensed. No telemetry, no analytics, no third-party CDN beyond api.github.com.
            PATs sit in your OS keychain. The whole project is one git clone away.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Screenshots -->
  <section class="border-b border-[var(--border)]">
    <div class="max-w-5xl mx-auto px-5 py-14">
      <h2 class="text-2xl font-semibold mb-6">What it looks like</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <figure class="rounded border border-[var(--border)] overflow-hidden bg-[#181818]">
          <img src={`${base}/screenshot-graph.svg`} alt="callmap callgraph view" class="w-full block" />
          <figcaption class="px-3 py-2 text-xs text-[var(--text-secondary)] border-t border-[var(--border)]">PR-delta callgraph</figcaption>
        </figure>
        <figure class="rounded border border-[var(--border)] overflow-hidden bg-[#181818]">
          <img src={`${base}/screenshot-source.svg`} alt="callmap source panel" class="w-full block" />
          <figcaption class="px-3 py-2 text-xs text-[var(--text-secondary)] border-t border-[var(--border)]">Source panel with highlighted changes</figcaption>
        </figure>
        <figure class="rounded border border-[var(--border)] overflow-hidden bg-[#181818]">
          <img src={`${base}/screenshot-vscode.svg`} alt="callmap inside VS Code" class="w-full block" />
          <figcaption class="px-3 py-2 text-xs text-[var(--text-secondary)] border-t border-[var(--border)]">Running inside VS Code</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section>
    <div class="max-w-3xl mx-auto px-5 py-16 text-center">
      <h2 class="text-2xl font-semibold mb-3">Try it on your next PR.</h2>
      <p class="text-[var(--text-secondary)] mb-7">
        Two minutes to install. Zero telemetry. Works on every public GitHub PR out of the box.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="https://github.com/eugine8248/callmap/releases" rel="noopener"
          class="!text-white !no-underline px-5 py-2.5 rounded bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-sm font-medium">
          Get callmap
        </a>
        <a href="https://github.com/eugine8248/callmap" rel="noopener"
          class="!text-[var(--text-primary)] !no-underline px-5 py-2.5 rounded border border-[var(--border-strong)] hover:bg-[var(--bg-sidebar)] text-sm">
          Star on GitHub
        </a>
      </div>
    </div>
  </section>
</Base>
